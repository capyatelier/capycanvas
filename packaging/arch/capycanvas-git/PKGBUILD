# Maintainer: Jordan Hubbard <jkh@FreeBSD.org>

pkgname=capycanvas-git
pkgver=r881.g173f760f
pkgrel=1
pkgdesc='GPU-accelerated drawing and painting application (development version)'
arch=('x86_64')
url='https://github.com/capyatelier/capycanvas'
license=('MIT OR Apache-2.0' 'LicenseRef-Capy-Canvas-Branding')
depends=('glibc' 'gcc-libs' 'gtk4>=1:4.22' 'libadwaita>=1:1.9' 'wayland' 'vulkan-icd-loader')
optdepends=('vulkan-driver: hardware Vulkan rendering (required at runtime)')
makedepends=('cmake' 'desktop-file-utils' 'git' 'meson' 'nasm' 'ninja' 'nodejs' 'python' 'rust')
provides=('capycanvas')
conflicts=('capycanvas')
options=('!debug')
source=(
  'capycanvas::git+https://github.com/capyatelier/capycanvas.git'
  'protected-paper-fix.patch::https://github.com/jordanhubbard/capycanvas/commit/3336fc79a83e2594a1919c4fe191809a4aa64783.patch'
  'libde265-1.1.3.tar.gz::https://github.com/strukturag/libde265/archive/refs/tags/v1.1.3.tar.gz'
  'dav1d-1.5.3.tar.xz::https://download.videolan.org/pub/videolan/dav1d/1.5.3/dav1d-1.5.3.tar.xz'
  'libheif-1.23.4.tar.gz::https://github.com/strukturag/libheif/archive/refs/tags/v1.23.4.tar.gz'
  'libavif-1.4.2.tar.gz::https://codeload.github.com/AOMediaCodec/libavif/tar.gz/refs/tags/v1.4.2'
)
sha256sums=(
  'SKIP'
  '54c0a618bed8b63991a078b786772970dd3bb1f5b9548ddc6bcc56654d054696'
  '189baa08fd6d2dd34db099de411bd6b2e6bd5eb88e81236a3d0fa3826b9715c4'
  '732010aa5ef461fa93355ed2c6c5fedb48ddc4b74e697eaabe8907eaeb943011'
  'ce7739356637b7371dcc0ae876027f6f692de9c9ace8cd0e9ed8d79a01ea61fe'
  '2b645287340ba5a631d268b551dc2d72bd73ac33335962dd36dcdb6d8366921d'
)

pkgver() {
  cd capycanvas
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd capycanvas
  if git apply --check "$srcdir/protected-paper-fix.patch"; then
    git apply "$srcdir/protected-paper-fix.patch"
  elif ! git apply --reverse --check "$srcdir/protected-paper-fix.patch"; then
    printf 'The temporary upstream build fix no longer applies cleanly.\n' >&2
    return 1
  fi
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd capycanvas
  python tools/build/photo-codecs.py \
    --cache "$srcdir"
  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS RUSTFLAGS
  node apps/layer-linux/package.mjs
}

check() {
  cd capycanvas
  cargo test --locked -p layer-ui
  cargo test --locked -p layer-linux
}

package() {
  cd capycanvas
  install -d "$pkgdir/usr"
  cp -a dist/capycanvas-linux/bin "$pkgdir/usr/"
  cp -a dist/capycanvas-linux/lib "$pkgdir/usr/"
  cp -a dist/capycanvas-linux/share "$pkgdir/usr/"

  # Build provenance is useful in the staged developer bundle, but source
  # archives and build helpers do not belong in the installed package.
  rm -rf "$pkgdir/usr/share/doc/capycanvas-photo-codecs/sources"
  rm -f \
    "$pkgdir/usr/share/doc/capycanvas-photo-codecs/heif_bridge.c" \
    "$pkgdir/usr/share/doc/capycanvas-photo-codecs/libheif-source-profile.patch" \
    "$pkgdir/usr/share/doc/capycanvas-photo-codecs/photo-codecs.py"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 BRANDING.md "$pkgdir/usr/share/licenses/$pkgname/BRANDING.md"
}
