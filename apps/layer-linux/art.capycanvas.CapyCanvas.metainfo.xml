  <releases>
    <release version="1.0.9" date="2026-10-06">
      <description>
        <p>The Linux battery indicator works without access to system services.</p>
        <ul>
          <li>Flatpak installations no longer request access to UPower.</li>
          <li>The battery indicator reads system batteries in the background and excludes connected accessories.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.8" date="2026-10-06">
      <description>
        <p>Linux software centers now show Capy Canvas in your language, with light and dark previews.</p>
        <ul>
          <li>Saving a read-only drawing opens a chooser so you can save an editable copy.</li>
          <li>The battery indicator and clock follow your desktop in Flatpak installations.</li>
          <li>Translated Histogram controls fit their labels.</li>
          <li>Drawings with filters reopen correctly after restarting the app.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.6" date="2026-10-05">
      <description>
        <p>Capy Canvas is available as a Flatpak for Linux.</p>
        <ul>
          <li>Open the downloaded Flatpak installer in your software manager to install Capy Canvas.</li>
          <li>Flatpak installations receive signed updates through your software manager.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.4" date="2026-10-05">
      <description>
        <p>A small update for Windows.</p>
        <ul>
          <li>The Windows uninstaller is signed, like the app and its setup program.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.3" date="2026-10-04">
      <description>
        <p>The first public beta of Capy Canvas, for Linux, Windows, macOS, iPad, Android tablets and the web.</p>
        <ul>
          <li>Enclose and Fill, under Lasso Fill, fills the empty areas inside a loop you draw.</li>
          <li>Edit Color has a new layout on Windows, macOS and iPad, with color values you can type, drag to adjust and copy.</li>
          <li>On macOS and iPad, tap a color fill's thumbnail, Paper included, to change its color.</li>
          <li>Layer thumbnails have rounded corners everywhere, and filters use the same effects icon throughout.</li>
          <li>Windows reopens all your windows at launch and asks about any drawing it could not restore.</li>
          <li>The Windows color wheel stays smooth while panels resize, and Export Preview on Windows works again.</li>
          <li>The Windows app and setup program are signed, and the Mac app is notarized by Apple.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.2" date="2026-10-04"/>
    <release version="1.0.1" date="2026-10-04"/>
    <release version="1.0.0" date="2026-10-04"/>
  </releases>
