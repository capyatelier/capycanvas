{
  "schema": 1,
  "motion_frames": 150,
  "documents": {
    "photo": {"kind": "photo"},
    "heavy": {"kind": "capy", "fixture": "heavy"},
    "vector": {"kind": "capy", "fixture": "vector"}
  },
  "steps": [
    {"id": "launch", "do": "launch"},
    {"id": "open.photo", "do": "open", "document": "photo"},
    {"id": "draw.pencil", "do": "stroke", "preset": 2, "size": 30, "zoom": 1.0, "contacts": 4, "path": "zigzag"},
    {"id": "draw.gpen", "do": "stroke", "preset": 1, "size": "guarantee", "zoom": "fit", "contacts": 1, "path": "ellipse"},
    {"id": "draw.paintbrush", "do": "stroke", "preset": 4, "size": 1024, "zoom": "fit", "contacts": 1, "path": "ellipse"},
    {"id": "draw.wet", "do": "stroke", "preset": 11, "size": 512, "zoom": "fit", "contacts": 1, "path": "ellipse", "duration_ms": 1000, "catch_up_cap_ms": 10000},
    {"id": "draw.blender", "do": "stroke", "preset": 45, "size": 512, "zoom": "fit", "contacts": 1, "path": "ellipse", "duration_ms": 1000, "catch_up_cap_ms": 10000},
    {"id": "draw.liquify", "do": "stroke", "preset": 12, "size": 512, "zoom": "fit", "contacts": 1, "path": "ellipse", "layer": "Photo"},
    {"id": "draw.clone", "do": "stroke", "preset": 40, "size": 512, "zoom": "fit", "contacts": 1, "path": "ellipse"},
    {"id": "undo", "do": "repeat", "count": 3, "commands": ["undo", "redo"], "surface": "canvas"},
    {"id": "nav.pan", "do": "gesture", "gesture": "pan"},
    {"id": "nav.pinch", "do": "gesture", "gesture": "pinch", "release": "quick"},
    {"id": "nav.rotate", "do": "gesture", "gesture": "rotate"},
    {"id": "nav.fit", "do": "repeat", "count": 2, "commands": ["fit_canvas"], "surface": "canvas"},
    {"id": "select.lasso", "do": "drag", "tool": "lasso", "target": "canvas", "path": "loop"},
    {"id": "select.wand", "do": "tap", "tool": "magic_wand", "target": "canvas", "points": [[0.3, 0.4], [0.6, 0.5], [0.5, 0.7]], "surface": "canvas"},
    {"id": "fill", "do": "tap", "tool": "fill", "target": "canvas", "points": [[0.25, 0.25], [0.75, 0.3], [0.5, 0.75]], "surface": "canvas"},
    {"id": "transform", "do": "drag", "command": "transform", "target": "canvas", "path": "arc", "then": "apply"},
    {"id": "filter.scrub", "do": "scrub", "effect": "curves", "frames": 150},
    {"id": "layers.opacity", "do": "scrub", "layer_opacity": [1.0, 0.2]},
    {"id": "layers.edit", "do": "repeat", "count": 2, "commands": ["add_layer", "delete_layer"], "surface": "window"},
    {"id": "ui.open", "do": "repeat", "count": 2, "open": ["panel:brushes", "menu:main"], "surface": "window"},
    {"id": "ui.slider", "do": "drag", "target": "slider:size", "path": "sweep"},
    {"id": "ui.scroll", "do": "drag", "target": "list:brushes", "path": "fling"},
    {"id": "ui.panel-drag", "do": "drag", "target": "grip:layers", "path": "float-and-return"},
    {"id": "ui.panel-resize", "do": "drag", "target": "edge:right-column", "path": "sweep"},
    {"id": "switch.workspace", "do": "repeat", "count": 2, "workspaces": ["photo", "start"], "surface": "window"},
    {"id": "open.heavy", "do": "open", "document": "heavy"},
    {"id": "heavy.draw", "do": "stroke", "preset": 1, "size": 100, "zoom": "fit", "contacts": 1, "path": "ellipse", "layer": "Masked"},
    {"id": "heavy.pinch", "do": "gesture", "gesture": "pinch"},
    {"id": "heavy.object", "do": "drag", "tool": "move", "target": "object:Image", "path": "arc"},
    {"id": "switch.tab", "do": "repeat", "count": 3, "tabs": ["photo", "heavy"], "surface": "canvas"},
    {"id": "save", "do": "save", "document": "heavy"},
    {"id": "open.vector", "do": "open", "document": "vector"},
    {"id": "vector.move", "do": "drag", "select": "all", "tool": "move", "target": "canvas", "path": "arc"},
    {"id": "vector.pan", "do": "gesture", "gesture": "pan"},
    {"id": "switch.resume", "do": "resume"},
    {"id": "close", "do": "close"}
  ]
}
