+        }
+        try await wait("brush \(preset) to be ready", seconds: 120) { store.snapshot["brush_ready"].bool }
+        try await settle()
+        record.extra["brush"] = ["preset": preset, "diameter": store.state["brush"]["diameter"].number, "zoom": store.state["camera"]["zoom"].number]
