                   tablet->pointer_info.surface_y);
+
+  /* A proximity frame can arrive before coordinates. Picking with the old
+   * position would briefly install a chrome/default cursor over the canvas.
+   * Enter only once the new position is known, before delivering its motion.
+   */
+  if (tablet->proximity_enter_pending)
+    {
+      tablet->proximity_enter_pending = FALSE;
+      gdk_wayland_tablet_add_frame_event (tablet, GDK_ENTER_NOTIFY, 0);
+    }
 
   gdk_wayland_tablet_add_frame_event (tablet, GDK_MOTION_NOTIFY, 0);
 }
