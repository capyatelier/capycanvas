+  tablet->proximity_enter_pending = TRUE;
 
   tablet->pointer_info.focus = g_object_ref (surface);
   tablet->pointer_info.cursor_shape = 0;
@@ -3079,6 +3089,16 @@
                   "tablet motion %f %f",
