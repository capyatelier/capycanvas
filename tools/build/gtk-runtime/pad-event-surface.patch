+GdkSurface *
+gdk_wayland_surface_from_wl_surface (struct wl_surface *surface)
+{
+  if (!surface ||
+      wl_proxy_get_listener ((struct wl_proxy *) surface) !=
+      (const void *) &surface_listener)
+    return NULL;
+
+  return wl_surface_get_user_data (surface);
+}
