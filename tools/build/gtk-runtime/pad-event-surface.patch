From: Jerome Abela
Subject: [PATCH] wayland: Track tablet pad focus independently
Origin: https://gitlab.gnome.org/GNOME/gtk/-/merge_requests/10171
Upstream-Commit: c6613dd0ad4e1bde77b6cd2e48cfcc80c8e63f33
License: LGPL-2.1-or-later

Backport to GTK 4.22.4, with the mode handler's focus/device guard
also applied to button, ring, strip and dial event construction.

--- a/gdk/wayland/gdkdevice-wayland-private.h
+++ b/gdk/wayland/gdkdevice-wayland-private.h
@@ -110,6 +110,7 @@
   GdkSeat *seat;
   struct zwp_tablet_pad_v2 *wp_tablet_pad;
   GdkDevice *device;
+  GdkSurface *focus;
 
   GdkWaylandTabletData *current_tablet;
 
--- a/gdk/wayland/gdkseat-wayland.c
+++ b/gdk/wayland/gdkseat-wayland.c
@@ -2269,6 +2269,8 @@
       _gdk_device_set_associated_device (pad->device, NULL);
       g_object_unref (pad->device);
     }
+
+  g_clear_object (&pad->focus);
 
   g_free (pad);
 }
@@ -3376,7 +3378,10 @@
   GDK_SEAT_DEBUG (seat, EVENTS,
                   "tablet pad ring handle frame, ring = %p", wp_tablet_pad_ring);
 
-  event = gdk_pad_event_new_ring (seat->keyboard_focus,
+  if (pad->focus == NULL || pad->device == NULL)
+    return;
+
+  event = gdk_pad_event_new_ring (pad->focus,
                                   pad->device,
                                   time,
                                   g_list_index (pad->mode_groups, group),
@@ -3453,7 +3458,10 @@
                   "tablet pad strip handle frame, strip = %p",
                   wp_tablet_pad_strip);
 
-  event = gdk_pad_event_new_strip (seat->keyboard_focus,
+  if (pad->focus == NULL || pad->device == NULL)
+    return;
+
+  event = gdk_pad_event_new_strip (pad->focus,
                                    pad->device,
                                    time,
                                    g_list_index (pad->mode_groups, group),
@@ -3577,9 +3585,13 @@
 
   group->mode_switch_serial = serial;
   group->current_mode = mode;
+
+  if (pad->focus == NULL || pad->device == NULL)
+    return;
+
   n_group = g_list_index (pad->mode_groups, group);
 
-  event = gdk_pad_event_new_group_mode (seat->keyboard_focus,
+  event = gdk_pad_event_new_group_mode (pad->focus,
                                         pad->device,
                                         time,
                                         n_group,
@@ -3616,7 +3628,10 @@
   GDK_SEAT_DEBUG (seat, EVENTS,
                   "tablet pad dial handle frame, dial = %p", wp_tablet_pad_dial);
 
-  event = gdk_pad_event_new_dial (seat->keyboard_focus,
+  if (pad->focus == NULL || pad->device == NULL)
+    return;
+
+  event = gdk_pad_event_new_dial (pad->focus,
                                   pad->device,
                                   time,
                                   g_list_index (pad->mode_groups, group),
@@ -3752,10 +3767,13 @@
 
   n_group = g_list_index (pad->mode_groups, group);
 
+  if (pad->focus == NULL || pad->device == NULL)
+    return;
+
   event = gdk_pad_event_new_button (state == ZWP_TABLET_PAD_V2_BUTTON_STATE_PRESSED
                                        ? GDK_PAD_BUTTON_PRESS
                                        : GDK_PAD_BUTTON_RELEASE,
-                                    GDK_WAYLAND_SEAT (pad->seat)->keyboard_focus,
+                                    pad->focus,
                                     pad->device,
                                     time,
                                     n_group,
@@ -3774,6 +3792,18 @@
 {
   GdkWaylandTabletPadData *pad = data;
   GdkWaylandTabletData *tablet = zwp_tablet_v2_get_user_data (wp_tablet);
+  GdkSurface *focus;
+
+  if (!surface)
+    return;
+
+  focus = wl_surface_get_user_data (surface);
+
+  if (!GDK_IS_SURFACE (focus))
+    return;
+
+  g_set_object (&pad->focus, focus);
+  pad->enter_serial = serial;
 
   GDK_SEAT_DEBUG (pad->seat, EVENTS,
                   "tablet pad handle enter, pad = %p, tablet = %p surface = %p",
@@ -3836,6 +3866,8 @@
       pad->current_tablet->pads = g_list_remove (pad->current_tablet->pads, pad);
       pad->current_tablet = NULL;
     }
+
+  g_clear_object (&pad->focus);
 }
 
 static void
