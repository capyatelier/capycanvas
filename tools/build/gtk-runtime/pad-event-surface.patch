+void
+gdk_wayland_seat_clear_pad_focus (GdkWaylandSeat *seat,
+                                 GdkSurface     *surface)
+{
+  GList *l;
+
+  for (l = seat->tablet_pads; l; l = l->next)
+    {
+      GdkWaylandTabletPadData *pad = l->data;
+
+      if (pad->focus == surface)
+        g_clear_object (&pad->focus);
+    }
+}
+
+static gboolean
+tablet_pad_has_focus (GdkWaylandTabletPadData *pad)
+{
+  return pad->device && pad->focus && !GDK_SURFACE_DESTROYED (pad->focus);
+}
