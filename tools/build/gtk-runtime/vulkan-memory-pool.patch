+    {
+      VkDeviceSize allocation_size = round_large_size (size);
+      guint j;
+
+      for (j = 0; j < self->n_held; j++)
+        {
+          if (self->held[j].allocation.size == allocation_size)
+            {
+              *alloc = self->held[j].allocation;
+              self->n_held--;
+              memmove (&self->held[j], &self->held[j + 1],
+                       (self->n_held - j) * sizeof (self->held[0]));
+              if (self->n_held == 0)
+                g_clear_handle_id (&self->release_source, g_source_remove);
+              alloc->size = size;
+              return;
+            }
+        }
+
+      gsk_vulkan_alloc (self->allocator, allocation_size, align, alloc);
+      alloc->size = size;
+      return;
+    }
+
   slot = find_slot (size);
-  if (slot >= self->block_size_slot)
-    {
-      gsk_vulkan_alloc (self->allocator, size, align, alloc);
-      return;
-    }
