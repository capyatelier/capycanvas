diff --git a/gsk/gpu/gskvulkanmemory.c b/gsk/gpu/gskvulkanmemory.c
--- a/gsk/gpu/gskvulkanmemory.c
+++ b/gsk/gpu/gskvulkanmemory.c
@@ -118,13 +118,66 @@
 
   GskVulkanAllocation cache;
   GskVulkanAllocationList free_lists[N_SUBDIVISIONS];
+
+  struct {
+    GskVulkanAllocation allocation;
+    gint64 release_time;
+  } held[4];
+  guint n_held;
+  guint release_source;
 };
+
+static VkDeviceSize
+round_large_size (VkDeviceSize size)
+{
+  VkDeviceSize step = 1;
+  VkDeviceSize remainder;
+
+  while (size / step > 15)
+    step <<= 1;
+
+  remainder = size % step;
+  if (remainder && size <= G_MAXUINT64 - (step - remainder))
+    size += step - remainder;
+
+  return size;
+}
+
+static void
+gsk_vulkan_buddy_allocator_free_held (GskVulkanBuddyAllocator *self,
+                                     gint64                   before)
+{
+  guint n = 0;
+
+  while (n < self->n_held && self->held[n].release_time <= before)
+    gsk_vulkan_free (self->allocator, &self->held[n++].allocation);
+
+  self->n_held -= n;
+  memmove (&self->held[0], &self->held[n], self->n_held * sizeof (self->held[0]));
+}
+
+static gboolean
+gsk_vulkan_buddy_allocator_release (gpointer data)
+{
+  GskVulkanBuddyAllocator *self = data;
+
+  gsk_vulkan_buddy_allocator_free_held (self, g_get_monotonic_time () - 100 * G_TIME_SPAN_MILLISECOND);
+  if (self->n_held > 0)
+    return G_SOURCE_CONTINUE;
+
+  self->release_source = 0;
+
+  return G_SOURCE_REMOVE;
+}
 
 static void
 gsk_vulkan_buddy_allocator_free_allocator (GskVulkanAllocator *allocator)
 {
   GskVulkanBuddyAllocator *self = (GskVulkanBuddyAllocator *) allocator;
   gsize i;
+
+  g_clear_handle_id (&self->release_source, g_source_remove);
+  gsk_vulkan_buddy_allocator_free_held (self, G_MAXINT64);
 
   if (self->cache.vk_memory)
     gsk_vulkan_free (self->allocator, &self->cache);
@@ -160,13 +213,32 @@
 
